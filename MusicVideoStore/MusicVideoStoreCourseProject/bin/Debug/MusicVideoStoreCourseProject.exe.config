<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Подключение к обычному SQL Server, который виден в SSMS как localhost. -->
    <add name="MasterConnection" connectionString="Data Source=localhost;Initial Catalog=master;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
    <add name="DefaultConnection" connectionString="Data Source=localhost;Initial Catalog=MusicVideoStore;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
